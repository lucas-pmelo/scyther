{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evt.video.completed.v1.schema.json",
  "title": "evt.video.completed v1",
  "description": "Frames extraídos, zip e miniatura gravados no S3. Consumido pela scyther-api (status COMPLETED) e pelo scyther-notifier (e-mail de conclusão).",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "evt.video.completed" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": [
        "videoId", "userId", "userEmail", "originalFilename",
        "frameCount", "zipKey", "zipSizeBytes", "thumbnailKey", "durationSeconds"
      ],
      "properties": {
        "videoId": { "$ref": "defs.schema.json#/$defs/videoId" },
        "userId": { "$ref": "defs.schema.json#/$defs/userId" },
        "userEmail": { "$ref": "defs.schema.json#/$defs/userEmail" },
        "originalFilename": { "$ref": "defs.schema.json#/$defs/originalFilename" },
        "frameCount": { "type": "integer", "minimum": 1 },
        "zipKey": { "$ref": "defs.schema.json#/$defs/zipKey" },
        "zipSizeBytes": {
          "description": "Medido ao fim do upload em streaming (ADR 0012).",
          "type": "integer",
          "minimum": 1
        },
        "thumbnailKey": { "$ref": "defs.schema.json#/$defs/thumbnailKey" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
